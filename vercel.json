{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:web:vercel",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "^/$",
      "dest": "/landing.html"
    },
    {
      "src": "^/landing/?$",
      "dest": "/landing.html"
    },
    {
      "src": "^/preview/?$",
      "dest": "/preview.html"
    },
    {
      "src": "^/app(?:/(.*))?$",
      "dest": "/index.html"
    }
  ]
}
